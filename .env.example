# Copy to apps/backend/.env.local and apps/frontend/.env.local
# Quote passwords with ! must be quoted.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

ADMIN_USERNAME=admin
ADMIN_PASSWORD="Admin!!@"

# OPERATOR_USERNAME=sales
# OPERATOR_PASSWORD="Sales!!@"

ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string

# Backend port (default 4000) — local dev only
PORT=4000

# Local dev only: frontend proxies /api to this URL when set.
# Leave unset on Vercel — the API runs in the same deployment (api/index.ts).
API_URL=http://localhost:4000

# Optional: direct API URL for browser fetch (leave empty to use same-origin /api)
NEXT_PUBLIC_API_URL=

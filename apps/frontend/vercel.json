{
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install --legacy-peer-deps",
  "buildCommand": "cd ../.. && npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "../../backend/dist/**,../../backend/src/server/config/data/**,../../backend/src/server/assets/**"
    }
  }
}
